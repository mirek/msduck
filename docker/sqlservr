#!/bin/sh
# Entry point installed at the SQL Server image's /opt/mssql/bin/sqlservr path.
# Ensures a TLS certificate exists, then starts the msduck container launcher.
set -eu
# Database, WAL, key and credential files are private to the server user.
umask 077
secrets=${MSDUCK_SECRETS_DIR:-/var/opt/mssql/secrets}
if [ -n "${MSDUCK_TLS_CERT:-}${MSDUCK_TLS_KEY:-}" ]; then
  # A mounted pair is used as given; the launcher reports missing files.
  cert=${MSDUCK_TLS_CERT:-}
  key=${MSDUCK_TLS_KEY:-}
else
  cert=$secrets/msduck-cert.pem
  key=$secrets/msduck-key.pem
  if [ ! -s "$cert" ] || [ ! -s "$key" ]; then
    # Like SQL Server, fall back to a self-signed certificate. It persists with
    # the volume so clients pinning it keep working across restarts. Generate
    # into temporary files and drop any stale certificate first: until the new
    # certificate lands it is missing, so an interrupted start regenerates both.
    mkdir -p "$secrets"
    host=$(hostname)
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -subj "/CN=$host" -addext "subjectAltName=DNS:$host,DNS:localhost,IP:127.0.0.1" \
      -keyout "$key.tmp" -out "$cert.tmp" 2>/dev/null
    rm -f "$cert"
    mv -f "$key.tmp" "$key"
    mv -f "$cert.tmp" "$cert"
    echo "msduck: generated self-signed TLS certificate $cert" >&2
  fi
fi
export MSDUCK_SECRETS_DIR="$secrets" MSDUCK_TLS_CERT="$cert" MSDUCK_TLS_KEY="$key"
exec /usr/local/bin/msduck-container
